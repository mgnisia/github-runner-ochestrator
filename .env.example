# Copy to .env (gitignored) and fill in. Consumed by scripts/tofu.ts and
# scripts/build-microvm-image.ts.

# ── OpenTofu S3 state backend (supplied to `tofu init` via -backend-config) ──
TF_STATE_BUCKET=842187392333-dev-club-coaster-eu-central-1
TF_STATE_REGION=eu-central-1

# ── Deploy inputs ────────────────────────────────────────────────────────────
# GitHub runner group id the JIT runners register into (required for Phase B).
RUNNER_GROUP_ID=

# MicroVM image ARNs — written automatically by `npm run build:images`.
# Leave unset for the Phase A apply (code bucket + build role only).
MICROVM_IMAGE_ARN_DOCKER=
MICROVM_IMAGE_ARN_NO_DOCKER=
